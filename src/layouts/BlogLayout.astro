---
import BaseLayout from "./BaseLayout.astro";
import { personReference } from "../utils/seo";
import { absoluteUrl, formatDate, site } from "../utils/site";

interface Props {
  title: string;
  description: string;
  pubDate?: Date;
  updatedDate?: Date;
  readingTime?: string;
  category?: string;
  tags?: string[];
  canonical?: string;
  audience?: string;
  problem?: string;
  ctaLabel?: string;
  ctaHref?: string;
  image?: string;
  imageAlt?: string;
  articleImages?: string[];
  faqs?: { question: string; answer: string }[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  readingTime,
  category,
  tags = [],
  canonical,
  audience,
  problem,
  ctaLabel,
  ctaHref,
  image = "/og-default.png",
  imageAlt,
  articleImages = [],
  faqs = []
} = Astro.props;
// The widest crop doubles as the on-page lead image, so the images referenced by
// BlogPosting.image are actually visible to readers rather than markup-only.
// generate-og-images.mjs emits the -16x9 suffix at a fixed 1200x675.
const leadImage =
  articleImages.find((source) => source.includes("-16x9")) ?? articleImages.at(-1);
const canonicalPath = canonical ?? Astro.url.pathname;
const canonicalUrl = canonicalPath.startsWith("http") ? canonicalPath : absoluteUrl(canonicalPath);
const hasValidationCta = Boolean(ctaLabel && ctaHref);
const metaParts = [
  readingTime,
  category
].filter(Boolean);
const blogPostingStructuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  datePublished: pubDate?.toISOString(),
  dateModified: (updatedDate ?? pubDate)?.toISOString(),
  keywords: tags,
  articleSection: category,
  image: (articleImages.length > 0 ? articleImages : [image]).map((item) => absoluteUrl(item)),
  audience: audience ? { "@type": "Audience", audienceType: audience } : undefined,
  about: problem,
  inLanguage: "en",
  // Named author for E-E-A-T. The @id matches the Person node emitted on other pages,
  // so search engines can join this post to the same author entity.
  author: {
    ...personReference(),
    "@type": "Person",
    name: site.author,
    url: absoluteUrl("/about/"),
    sameAs: Object.values(site.socials)
  },
  isPartOf: {
    "@type": "Blog",
    name: `${site.name} Writing`,
    url: absoluteUrl("/writing/")
  }
};
const faqStructuredData =
  faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "@id": `${canonicalUrl}#faq`,
        mainEntity: faqs.map((faq) => ({
          "@type": "Question",
          name: faq.question,
          acceptedAnswer: { "@type": "Answer", text: faq.answer }
        }))
      }
    : undefined;
const breadcrumb = [
  { name: "Writing", item: absoluteUrl("/writing/") },
  { name: title, item: canonicalUrl }
];
const showUpdated =
  updatedDate && pubDate && formatDate(updatedDate) !== formatDate(pubDate);
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalPath}
  image={image}
  imageAlt={imageAlt ?? title}
  ogType="article"
  articlePublishedTime={pubDate?.toISOString()}
  articleModifiedTime={(updatedDate ?? pubDate)?.toISOString()}
  articleSection={category}
  articleTags={tags}
  includeStructuredAuthor={false}
  breadcrumb={breadcrumb}
  structuredData={faqStructuredData ? [blogPostingStructuredData, faqStructuredData] : blogPostingStructuredData}
>
  <article class="container page">
    <p class="back">
      <a class="link" href="/writing/">← Writing</a>
    </p>
    <h1>{title}</h1>
    <p class="byline">
      By <a class="link" href="/about/" rel="author">{site.author}</a>
      {pubDate && (
        <>
          {" · "}
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        </>
      )}
      {showUpdated && updatedDate && (
        <>
          {" · Updated "}
          <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
        </>
      )}
    </p>
    {metaParts.length > 0 && <p class="meta">{metaParts.join(" · ")}</p>}
    {
      leadImage && (
        <img
          class="lead-image"
          src={leadImage}
          alt={imageAlt ?? title}
          width="1200"
          height="675"
          fetchpriority="high"
          decoding="async"
        />
      )
    }
    <div class="prose-custom body">
      <slot />
    </div>
    {
      faqs.length > 0 && (
        <section class="prose-custom faq" aria-labelledby="faq-heading">
          <h2 id="faq-heading">Frequently asked questions</h2>
          {faqs.map((faq) => (
            <>
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </>
          ))}
        </section>
      )
    }
    {
      hasValidationCta && (
        <p class="article-cta">
          <a
            class="link"
            href={ctaHref}
            data-analytics-event="idea_interest_click"
            data-analytics-category="validation"
            data-analytics-label={ctaLabel}
            data-analytics-location="article_footer"
          >
            {ctaLabel}
          </a>
        </p>
      )
    }
  </article>
</BaseLayout>

<style>
  .page {
    padding-top: clamp(2.5rem, 7vw, 4.5rem);
  }

  .back {
    margin: 0 0 2rem;
    font-size: 0.9rem;
  }

  h1 {
    max-width: 38rem;
    margin: 0;
    font-size: 1.4rem;
    font-weight: 600;
  }

  .byline {
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .byline + .meta {
    margin-top: 0.2rem;
  }

  .faq {
    max-width: 38rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .meta {
    margin: 0.7rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .lead-image {
    display: block;
    width: 100%;
    max-width: 38rem;
    height: auto;
    margin: 2rem 0 0;
    border: 1px solid var(--border);
    border-radius: 10px;
  }

  .body {
    max-width: 38rem;
    margin-top: 2rem;
  }

  .article-cta {
    margin-top: 2rem;
  }
</style>
